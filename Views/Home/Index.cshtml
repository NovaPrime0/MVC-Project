@model Profile

@{
    ViewData["Title"] = "Home";
}

<section id="home" class="hero">
    <p class="hero-label">Portfolio</p>
    <h1 class="hero-name">@Model.Name</h1>
    <p class="hero-headline">@Model.Headline</p>
    <p class="hero-location">@Model.Location</p>

    <div class="hero-actions">
        <a href="#contact" class="btn-main">Get in touch</a>
        <a href="@Model.GithubUrl" class="btn-outline">GitHub</a>
    </div>
</section>

<hr />

<section id="about">
    <h2 class="section-title">About</h2>
    <p>@Model.Bio</p>
</section>

<hr />

<section id="skills">
    <h2 class="section-title">Skills</h2>
    <div class="skills-grid">
        @foreach (var group in Model.Skills)
        {
            <div class="skill-group">
                <h4>@group.Category</h4>
                <ul class="chips">
                    @foreach (var item in group.Items)
                    {
                        <li>@item</li>
                    }
                </ul>
            </div>
        }
    </div>
</section>

<hr />

<section id="experience">
    <h2 class="section-title">Experience</h2>
    @foreach (var job in Model.Experience)
    {
        <div class="entry">
            <div class="entry-head">
                <h4>@job.Role</h4>
                <span class="entry-years">@job.Years</span>
            </div>
            <p class="entry-place">@job.Place</p>
            <p>@job.Details</p>
        </div>
    }
</section>

<hr />

<section id="projects">
    <h2 class="section-title">Projects</h2>
    <div class="project-grid">
        @foreach (var p in Model.Projects)
        {
            <article class="project-card">
                <span class="project-status">@p.Status</span>
                <h4>@p.Title</h4>
                <p>@p.Summary</p>
                <ul class="project-tech">
                    @foreach (var t in p.TechUsed)
                    {
                        <li>@t</li>
                    }
                </ul>
                <a href="@p.RepoUrl" target="_blank" rel="noopener">View on GitHub &rarr;</a>
            </article>
        }
    </div>
</section>

<hr />

<section id="education">
    <h2 class="section-title">Education</h2>
    @foreach (var e in Model.Education)
    {
        <div class="entry">
            <div class="entry-head">
                <h4>@e.Degree</h4>
                <span class="entry-years">@e.Years</span>
            </div>
            <p class="entry-place">@e.School</p>
        </div>
    }
</section>

<hr />

<section id="contact">
    <h2 class="section-title">Contact</h2>
    <p>Want to work together or just say hi? Send me a message.</p>
    <div class="hero-actions">
        <a href="mailto:@Model.Email" class="btn-main">Email me</a>
        <a href="@Model.GithubUrl" class="btn-outline">GitHub</a>
    </div>
</section>